<Window x:Class="WhyDidItBuild.UI.ImportBuildOutputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Build Output" Height="520" Width="760"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Paste the Build output for one build, or load a text file. If the text contains more than one build summary, only the last build is used. This does not start a build." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Load file..." Margin="0,0,8,0" Padding="8,4" Click="LoadFileClick" />
      <Button Content="Import" IsDefault="True" Margin="0,0,8,0" Padding="8,4" Click="ImportClick" />
      <Button Content="Cancel" IsCancel="True" Padding="8,4" />
    </StackPanel>
    <TextBox x:Name="OutputBox" AcceptsReturn="True" AcceptsTab="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" />
  </DockPanel>
</Window>
