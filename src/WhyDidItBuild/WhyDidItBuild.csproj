<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WhyDidItBuild</RootNamespace>
    <AssemblyName>WhyDidItBuild</AssemblyName>
    <UseWPF Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</UseWPF>
  </PropertyGroup>

  <!--
    SDK and manifest checked against current Visual Studio guidance:
    Microsoft.VisualStudio.SDK 17.14.40265 and Microsoft.VSSDK.BuildTools 17.14.2142
    are the supported 17.x surface. Visual Studio 2026 loads API 17.x and evaluates
    only the InstallationTarget lower bound, so Version="[17.0,)" installs on both
    Visual Studio 2022 and Visual Studio 2026. The project does not reference the 18.x SDK.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Polyfill" Version="11.4.5" PrivateAssets="all" />
    <Using Include="Microsoft.VisualStudio.Threading" />
    <Reference Include="System.Design" />
    <ProjectReference Include="..\WhyDidItBuild.Core\WhyDidItBuild.Core.csproj" />
    <ProjectReference Include="..\WhyDidItBuild.Binlog\WhyDidItBuild.Binlog.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <VSCTCompile Include="WhyDidItBuild.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <!-- This machine is not Windows, so the VSIX project compiles a stub instead of the Visual Studio SDK. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="NonWindowsBuildStub.cs" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="NonWindowsBuildStub.cs" />
  </ItemGroup>
</Project>
