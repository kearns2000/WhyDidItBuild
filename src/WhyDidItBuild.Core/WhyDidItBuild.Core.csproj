<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WhyDidItBuild.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <!-- Source-only polyfills (Index/Range, records, required members, newer string and collection APIs) for the net472 build the VSIX consumes. -->
    <PackageReference Include="Polyfill" Version="11.4.5" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- The net472 BCL has no nullable annotations, so flow analysis there is noise. The net10.0 build still enforces it. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>
</Project>